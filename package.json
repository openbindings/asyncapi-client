{
  "name": "openbindings-asyncapi-client-workspace",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "build": "pnpm --dir typescript build",
    "test": "pnpm --dir typescript test",
    "test:go": "cd go && GOWORK=off GOCACHE=/tmp/openbindings-asyncapi-client-go-cache go test -race ./...",
    "lint": "pnpm --dir typescript lint",
    "boundary": "pnpm build && node scripts/verify-boundary.mjs",
    "verify": "pnpm lint && pnpm test && pnpm test:go && pnpm boundary",
    "verify:consumers": "node scripts/verify-clean-consumers.mjs",
    "qualify:release": "pnpm verify && pnpm verify:consumers"
  }
}
